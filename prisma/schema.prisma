generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id                            String                     @id @default(uuid())
  name                          String
  email                         String                     @unique
  // Opcional desde o login com Google: uma conta criada por provedor social
  // nasce sem senha. `AuthService.login` trata `password == null` como
  // credencial inválida (mesmo 401 de senha errada) antes de chamar o bcrypt,
  // que quebra com null. Quem entrou só por Google define uma senha via
  // `POST /users/me/set-password` ou pelo fluxo de "esqueci minha senha".
  password                      String?
  createdAt                     DateTime                   @default(now())
  updatedAt                     DateTime                   @updatedAt
  refreshSessions               RefreshSession[]
  emailVerificationToken        String?                    @unique
  emailVerificationTokenExpires DateTime?
  emailVerified                 Boolean                    @default(false)
  passwordResetExpires          DateTime?
  passwordResetToken            String?
  pendingEmail                  String?
  pendingEmailToken             String?                    @unique
  pendingEmailExpires           DateTime?
  isAdmin                       Boolean                    @default(false)
  completedConsecrationDays     ConsecrationCompletedDay[]
  consecrations                 ConsecrationProgress[]
  conversations                 Conversation[]
  rosarySessions                RosarySession[]
  spiritualStats                SpiritualStats?
  activities                    UserActivity[]
  readingProgress               ReadingProgress[]
  pushSubscriptions             PushSubscription[]
  notifications                 Notification[]
  quaresmaDays                  QuaresmaMichaelDay[]
  quaresmaPenances              QuaresmaMichaelPenance[]
  bibleMarks                    BibleMark[]
  bibleCollections              BibleCollection[]
  notificationProfile           UserNotificationProfile?
  linkedAccounts                LinkedAccount[]

  // Perfil de resposta do VoxAI (chave de VOX_PROFILE_KEYS, ex.: "STUDY").
  // null = a pessoa nunca escolheu → comportamento = DEFAULT ("Padrão").
  voxProfile          String?
  // Carimbado quando a pessoa escolhe um perfil OU dispensa o card de
  // novidade. O onboarding do Vox só aparece enquanto voxProfile E
  // voxOnboardingSeenAt são ambos null.
  voxOnboardingSeenAt DateTime?
}

model PushSubscription {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  endpoint  String   @unique
  p256dh    String
  auth      String
  timezone  String   @default("UTC")
  createdAt DateTime @default(now())

  @@index([userId])
}

// Uma linha por dispositivo/login ativo. Antes disso o refresh token
// vivia num campo único em User — logar num segundo aparelho sobrescrevia
// o token do primeiro, derrubando a sessão dele silenciosamente. Agora
// cada login cria sua própria sessão, e renovar uma não mexe nas outras.
model RefreshSession {
  id          String   @id @default(uuid())
  userId      String
  tokenHash   String
  createdAt   DateTime @default(now())
  expiresAt   DateTime
  userAgent   String?
  deviceLabel String?
  ipAddress   String?
  location    String?
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// Vínculo entre um User e uma identidade de um provedor social (Google hoje;
// o formato comporta Apple depois SEM mexer em User). Uma linha por
// (provider, conta no provider). `providerAccountId` é o `sub` do id_token —
// id opaco e estável do provedor, NUNCA o e-mail (o e-mail do Google pode
// mudar; o `sub` não). `emailSnapshot` é o e-mail que o provedor afirmou
// (com email_verified=true) no momento da ligação: registro para auditar
// uma contestação futura, não fonte de login. A linha só é criada depois
// de o backend confirmar email_verified=true.
model LinkedAccount {
  id                String   @id @default(uuid())
  userId            String
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  provider          String // "google"
  providerAccountId String
  emailSnapshot     String
  linkedAt          DateTime @default(now())

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model UserActivity {
  id        String   @id @default(uuid())
  userId    String
  type      String
  action    String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  // O classificador de faixa horária (notifications) varre as atividades
  // dos últimos ~30 dias por usuário — sem este índice seria um seq scan
  // na tabela inteira a cada recálculo.
  @@index([userId, createdAt])
}

// Faixa horária preferida de cada usuário, derivada da atividade recente
// (UserActivity, ~30 dias, hora local Brasil) pra alinhar as notificações
// automáticas ao horário em que a pessoa costuma usar o app. Enxuto de
// propósito: só o valor e quando foi calculado. Recalculado
// preguiçosamente pelo próprio tick quando passa de ~7 dias.
model UserNotificationProfile {
  userId         String    @id
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  activeBand     String    @default("ANY") // "MORNING" | "AFTERNOON" | "EVENING" | "ANY"
  bandComputedAt DateTime?
  updatedAt      DateTime  @updatedAt
}

// Uma linha por usuário representando a consagração ATUAL (ou mais
// recente). `completedAt` distingue quem terminou os 33 dias de quem
// cancelou no meio — cancelar apaga a linha, terminar preenche este
// campo e mantém tudo (a tela de finalização e as estatísticas do admin
// dependem dessa diferença). Começar de novo depois de terminar apaga a
// linha antiga (e seus dias) antes de criar a nova.
model ConsecrationProgress {
  id          String    @id @default(uuid())
  startDate   DateTime
  userId      String
  completedAt DateTime?
  createdAt   DateTime  @default(now())
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId])
}

model ConsecrationStage {
  id          String            @id @default(uuid())
  title       String
  description String?
  order       Int
  days        Int
  daysContent ConsecrationDay[]
}

model ConsecrationDay {
  id        String            @id @default(uuid())
  dayNumber Int
  title     String?
  stageId   String
  stage     ConsecrationStage @relation(fields: [stageId], references: [id], onDelete: Cascade)
  prayers   DayPrayer[]
}

model Prayer {
  id      String      @id @default(uuid())
  title   String
  content String
  days    DayPrayer[]
}

model DayPrayer {
  id       String          @id @default(uuid())
  order    Int
  dayId    String
  prayerId String
  day      ConsecrationDay @relation(fields: [dayId], references: [id], onDelete: Cascade)
  prayer   Prayer          @relation(fields: [prayerId], references: [id])
}

model ConsecrationCompletedDay {
  id        String   @id @default(uuid())
  dayNumber Int
  userId    String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, dayNumber])
}

model PrayerCategory {
  id        String          @id @default(uuid())
  name      String
  slug      String          @unique
  createdAt DateTime        @default(now())
  prayers   GeneralPrayer[]
}

model GeneralPrayer {
  id         String         @id @default(uuid())
  title      String
  content    String
  categoryId String
  createdAt  DateTime       @default(now())
  category   PrayerCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)
}

model RosarySession {
  id             String    @id @default(uuid())
  userId         String
  type           String    @default("gozosos")
  currentStep    Int       @default(0)
  elapsedSeconds Int       @default(0)
  completed      Boolean   @default(false)
  startedAt      DateTime  @default(now())
  finishedAt     DateTime?
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, type, completed])
}

model SpiritualStats {
  id             String    @id @default(uuid())
  userId         String    @unique
  rosariesPrayed Int       @default(0)
  prayersPrayed  Int       @default(0)
  prayerStreak   Int       @default(0)
  lastPrayerDate DateTime?
  lastLoginDate  DateTime?
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Conversation {
  id          String    @id @default(uuid())
  userId      String
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  title       String?
  hasMessages Boolean   @default(false)
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages    Message[]
}

model Message {
  id             String       @id @default(uuid())
  role           String
  content        String
  conversationId String
  createdAt      DateTime     @default(now())
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
}

// Tipo de leitura contínua que a Home usa pra sugerir "volte de onde parou".
enum ReadingKind {
  BIBLE
  CATECHISM
}

// Última posição de leitura da pessoa em cada frente (Bíblia, Catecismo).
// Só marca ONDE parou — uma linha por (usuário, tipo), sempre sobrescrita.
// `reference` é o ponteiro que a UI usa pra navegar (ex.: "genesis/3" ou
// a página do PDF do Catecismo); `label` é o texto amigável ("Gênesis 3").
// Tabela nova e isolada — não altera nada do que já existe.
model ReadingProgress {
  id        String      @id @default(uuid())
  userId    String
  kind      ReadingKind
  reference String
  label     String
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt
  user      User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, kind])
  @@index([userId])
}

// De onde a notificação veio: um envio do admin (CAMPAIGN) ou uma
// regra automática (RULE), como "terço não terminado".
enum NotificationSource {
  CAMPAIGN
  RULE
}

// Registro do envio feito pelo admin — agrupa as Notifications geradas
// e guarda os contadores (alvo/enviado/falhou) pro painel. Expira em 15
// dias, igual aos itens; um cron limpa as vencidas.
model NotificationCampaign {
  id            String         @id @default(uuid())
  title         String
  body          String?
  url           String?
  audience      String         @default("ALL") // "ALL" | "SPECIFIC"
  createdBy     String?
  createdAt     DateTime       @default(now())
  expiresAt     DateTime
  targeted      Int            @default(0)
  pushSent      Int            @default(0)
  pushFailed    Int            @default(0)
  notifications Notification[]

  @@index([expiresAt])
}

// Um item na "caixa de entrada" (sino) de cada usuário. Toda notificação
// vira uma linha por pessoa; quem ativou push também recebe fora do app.
// `seenAt` controla o badge do sino; `expiresAt` (criadaEm + 7 dias)
// tira do sino e do painel; um cron apaga as vencidas.
model Notification {
  id         String                @id @default(uuid())
  userId     String
  user       User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  title      String
  body       String?
  url        String?
  source     NotificationSource    @default(CAMPAIGN)
  campaignId String?
  campaign   NotificationCampaign? @relation(fields: [campaignId], references: [id], onDelete: SetNull)
  ruleKey    String?
  // Qual variante de texto foi usada (Fase 4). Nullable/aditivo: campanhas
  // e notificações antigas não têm. O scheduler usa isto pra rodar as
  // variantes ("a menos usada recentemente por este usuário").
  variantId  String?
  pushSent   Boolean               @default(false)
  createdAt  DateTime              @default(now())
  seenAt     DateTime?
  expiresAt  DateTime

  @@index([userId, expiresAt])
  @@index([userId, seenAt])
  @@index([expiresAt])
}

// Regras de notificação automática (terço não terminado, liturgia, etc.).
// O texto e o liga/desliga ficam aqui (editáveis no admin); QUANDO e PRA
// QUEM disparar é lógica de código, por `key`. Usa {count} no corpo pra
// interpolar valores (ex.: dias de sequência).
model NotificationRule {
  key           String                    @id @default(uuid())
  enabled       Boolean                   @default(true)
  title         String
  body          String?
  url           String?
  hour          Int? // hora local (0-23) das regras por horário
  condition     String? // "ROSARY_UNFINISHED" | "STREAK_AT_RISK" | null (=diária no horário)
  // Knobs editáveis no admin (Fase 2). Aditivos e nullable: regra sem valor
  // usa o default de código de sempre, então banco antigo se comporta igual.
  // `thresholdDays` = "parado há N dias" das condições que usam janela
  // (readingResume, rosaryLapse, comeback). `band` = faixa de horário
  // preferida: "MORNING" | "AFTERNOON" | "EVENING" | "ANY".
  thresholdDays Int?
  band          String?
  updatedAt     DateTime                  @updatedAt
  variants      NotificationRuleVariant[]
}

// Pool de textos de uma regra (Fase 4). Cada disparo escolhe a variante
// que aquele usuário recebeu há mais tempo (ou nunca) — assim a mesma
// regra deixa de mandar sempre a MESMA frase. Toda regra é semeada com
// 1 variante a partir do seu title/body/url atuais; o piso de "1 variante
// ativa por regra" é garantido pela API e pela UI, não pelo schema.
model NotificationRuleVariant {
  id        String           @id @default(uuid())
  ruleKey   String
  rule      NotificationRule @relation(fields: [ruleKey], references: [key], onDelete: Cascade)
  title     String?
  body      String?
  url       String?
  enabled   Boolean          @default(true)
  order     Int              @default(0)
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  @@index([ruleKey])
}

// Bloco de configuração do funil anti-spam — linha única (`id = "default"`).
// Antes esses parâmetros eram constantes privadas em notifications.scheduler.ts;
// agora ficam editáveis no admin sem deploy. Todos os defaults reproduzem
// exatamente o comportamento anterior, então um banco sem esta linha (ou com
// o banco fora do ar) se comporta igual ao de antes.
model NotificationSettings {
  id              String   @id @default("default")
  maxPerDay       Int      @default(2) // teto de automáticas por pessoa por dia
  maxNudgesPerDay Int      @default(1) // teto de "convites" (não-urgentes) por dia
  quietStart      Int      @default(22) // hora local a partir da qual não incomodar
  quietEnd        Int      @default(7) // hora local antes da qual não incomodar
  spacingHours    Int      @default(6) // horas mínimas entre duas automáticas
  restGapEnabled  Boolean  @default(true) // gap de descanso (dias vazios entre notificações)
  urgentThreshold Int      @default(80) // priority >= isso = urgente (passa na frente)
  updatedAt       DateTime @updatedAt
}

// Quaresma de São Miguel — devoção sazonal de 40 dias de oração que vai
// de 15/08 até a Festa de São Miguel (29/09), pulando os domingos (dia de
// descanso/Missa). Uma linha por dia concluído.
//
// O `year` existe porque a devoção volta sozinha todo ano: sem ele, o
// progresso da edição de 2026 já deixaria a de 2027 "concluída" no dia 1.
model QuaresmaMichaelDay {
  id        String   @id @default(uuid())
  userId    String
  year      Int
  dayNumber Int
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, year, dayNumber])
  @@index([userId, year])
}

// Texto livre onde a pessoa registra as penitências que ofereceu na
// edição do ano. Uma linha por (usuário, ano) — o unique cuida do upsert.
model QuaresmaMichaelPenance {
  id        String   @id @default(uuid())
  userId    String
  year      Int
  content   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, year])
}

// Estudo da Bíblia — uma linha por versículo que o usuário marcou de
// alguma forma. `highlighted`/`favorite`/`note` são independentes; quando
// os três ficam vazios o service APAGA a linha (não existe "linha sem
// nada"), então a existência da linha nunca é fonte de verdade sozinha.
// `reference` ("João 3,16") e `text` (o versículo) são snapshots mandados
// pelo cliente — o backend não tem o texto bíblico, que vive no bundle do
// frontend. Texto bíblico é estático, o snapshot não envelhece.
model BibleMark {
  id             String   @id @default(uuid())
  userId         String
  book           String
  chapter        Int
  verse          Int
  reference      String
  text           String
  highlighted    Boolean  @default(false)
  // Cor do grifo quando highlighted=true: amber | green | blue | pink |
  // purple. null quando não há grifo. Sem legenda/significado — é só a cor.
  highlightColor String?
  favorite       Boolean  @default(false)
  note           String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, book, chapter, verse])
  @@index([userId])
}

// Pasta nomeada onde a pessoa junta versículos para estudar ("Promessas
// de Deus", "Estudo sobre a fé"). Sem unicidade de nome — pode haver duas
// "Fé". Apagar a coleção apaga os itens (cascata).
model BibleCollection {
  id        String                @id @default(uuid())
  userId    String
  name      String
  createdAt DateTime              @default(now())
  updatedAt DateTime              @updatedAt
  user      User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  items     BibleCollectionItem[]

  @@index([userId])
}

// Um versículo dentro de uma coleção. `reference`/`text` são snapshots
// (mesma razão do BibleMark). `note` é uma observação específica desta
// coleção, separada da anotação global do versículo (BibleMark.note).
model BibleCollectionItem {
  id           String          @id @default(uuid())
  collectionId String
  book         String
  chapter      Int
  verse        Int
  reference    String
  text         String
  note         String?
  createdAt    DateTime        @default(now())
  collection   BibleCollection @relation(fields: [collectionId], references: [id], onDelete: Cascade)

  @@unique([collectionId, book, chapter, verse])
  @@index([collectionId])
}
